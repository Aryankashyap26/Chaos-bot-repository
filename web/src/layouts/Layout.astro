---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Chaos Bot — High-Impact AI Intelligence", 
  description = "A minimalist, unfiltered AI assistant combining raw creative chaos with razor-sharp reasoning. Inspired by Cal.com brutalist clarity." 
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Open Graph / Meta -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://chaosbot.com" />
    <meta property="og:type" content="website" />

    <!-- Google Fonts for Cal.com Typography -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>
  <body class="bg-[#09090b] text-[#f4f4f5] min-h-screen selection:bg-neutral-800 selection:text-white">
    <slot />
  </body>
</html>

<style is:global>
  body {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  }
  code, pre, .font-mono-code {
    font-family: 'JetBrains Mono', monospace;
  }
</style>
